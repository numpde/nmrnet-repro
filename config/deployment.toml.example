# Private machine settings: copy to config/deployments/<name>/deployment.toml.
# The public provider definition uses logical paths; this file owns host storage.
store_root = "/srv/nmrnet/attempts"
maximum_startup_bytes = 2097152
# Use actual interface and resolver values; there is no ambient-route fallback.
resolvers = ["YOUR_IPV4_RESOLVER"]

[routes.api]
mode = "external"
interface = "YOUR_INTERFACE"

[routes.interpreter]
mode = "external"
interface = "YOUR_INTERFACE"

[routes.store]
mode = "external"
interface = "YOUR_INTERFACE"
