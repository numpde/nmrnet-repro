# Private machine settings: copy to config/deployments/<name>/deployment.toml.
# Interpreter/Upload routes and startup limits are machine-specific; checkpoints use named Docker volumes.
# Set the shared API proxy/outbox project and socket group in [deployment].
maximum_startup_bytes = 2097152
# Use actual interface and resolver values; there is no ambient-route fallback.
resolvers = ["YOUR_IPV4_RESOLVER"]

[deployment]
project = "nmr-shared-example"
gid = 10003

[routes.interpreter]
mode = "external"
interface = "YOUR_INTERFACE"
log_level = "INFO"

[routes.store]
mode = "external"
interface = "YOUR_INTERFACE"
log_level = "INFO"
