schema_id = "nmrnet.provider.runtime_config.v3"

# Copy to config/deployments/<name>/provider.toml.
# API settings and credentials live in secrets/deployments/<name>/api.toml and
# separate input files. Socket grants come from the host's shared settings.

[scientific_retry]
max_retries = 0

[interpreter]
max_turns = 6

[[interpreter.endpoints]]
configuration_id = "openai-gpt-5-6-luna"
url = "https://api.openai.com/v1/chat/completions"
model = "gpt-5.6-luna"
key_file = "/srv/nmrnet/input/interpreter.key"
request_bytes = 65536
response_bytes = 262144
exchange_seconds = 25
retirement_seconds = 5
reasoning_effort = "none"

[uploads]
store_origin = "https://nmr.localhost:10443"
per_source_bytes = 1048576
total_bytes = 2097152
requests = 8
seconds = 300
exchange_seconds = 10
retirement_seconds = 5
ca_file = "/srv/nmrnet/input/api-ca.crt"

[preparation]
seed = 17
max_iterations = 200
timeout_seconds = 1
generation_seconds = 5
max_worker_calls = 2
seconds = 240

[lifecycle]
consumer_id = "lane:nmrnet-local"
generation_id = "generation:local"
lifetime_root = "/srv/nmrnet/attempts"
maximum_live_attempts = 2
maximum_control_bytes = 262144
maximum_pending_terminal_bytes = 4194304
start_replays = 1
start_seconds = 90
allowed_job_states = ["open"]
poll_seconds = 2
task_settle_seconds = 10
observation_gap_seconds = 60

[service]
display_name = "NMRNet++"
description = "NMRNet++ predicts per-atom ¹H and ¹³C chemical shifts (ppm) from 3D molecular coordinates using released models. Supply coordinates or generate conformers from SMILES. [Scientific guide](https://numpde.github.io/nmrnet-repro/)"
page_size = 100
maximum_pages = 10
idle_seconds = 2
api_backoff_max_seconds = 30
hello_seconds = 60
# Log when shutdown is still waiting for an admitted Attempt after this time.
drain_seconds = 120
settle_seconds = 10
allocation_seconds = 30
prediction_seconds = 90
source_seconds = 10

[delivery]
retry_initial_seconds = 1
retry_max_seconds = 30
