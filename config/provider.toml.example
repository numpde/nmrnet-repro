schema_id = "nmrnet.provider.runtime_config.v1"

# Copy to config/deployments/<name>/provider.toml; keep credentials in secrets/deployments/<name>/.
[api]
origin = "https://nmr.localhost:10443"
profile = "dev-local"
topology = "dev-local"
provider_ref = "provider:example"
credential_file = "/srv/nmrnet/input/signing.private.json"
exchange_seconds = 10
retirement_seconds = 5
ca_file = "/srv/nmrnet/input/api-ca.crt"

[interpreter]
max_turns = 6

[[interpreter.endpoints]]
configuration_id = "openai-gpt-5-6-luna"
url = "https://api.openai.com/v1/chat/completions"
model = "gpt-5.6-luna"
key_file = "/srv/nmrnet/input/interpreter.key"
request_bytes = 65536
response_bytes = 262144
exchange_seconds = 25
retirement_seconds = 5
reasoning_effort = "none"

[uploads]
store_origin = "https://nmr.localhost:10443"
per_source_bytes = 1048576
total_bytes = 2097152
requests = 8
seconds = 300
exchange_seconds = 10
retirement_seconds = 5
ca_file = "/srv/nmrnet/input/api-ca.crt"

[preparation]
seed = 17
max_iterations = 200
timeout_seconds = 1
generation_seconds = 5
max_worker_calls = 2
seconds = 240

[lifecycle]
consumer_id = "lane:nmrnet-local"
generation_id = "generation:local"
store_root = "/srv/nmrnet/attempts"
maximum_records = 2
maximum_checkpoint_bytes = 262144
store_seconds = 10
allowed_job_states = ["open"]
poll_seconds = 2
task_settle_seconds = 10
observation_gap_seconds = 60

[service]
display_name = "NMRNet++"
description = "NMRNet++ predicts per-atom H/C chemical shifts from 3D molecular coordinates. Scientific guide, limits, references and source: https://numpde.github.io/nmrnet-repro/"
offering_description = """
Predicted per-atom ¹H/¹³C chemical shifts (ppm) from 3D coordinates. [Inputs, settings and scientific limits](https://numpde.github.io/nmrnet-repro/)

Choose one:

- Paste element symbols and Cartesian coordinates for one geometry, with units.
- Attach a 3D coordinate file; specify units and which structures to use.
- Supply SMILES and request 1–128 conformers.

Supplied geometries return shifts only for H/C atoms with explicit coordinates. Missing H is not added and can alter remaining H/C shifts. SMILES must specify the intended protonation state; preparation adds its H and generates coordinates.

Limit: 128 atoms per geometry, including H added from SMILES. Each geometry gets separate shifts; conformers are not averaged. No solvent or temperature input is supported; this does not imply gas-phase conditions."""
page_size = 100
maximum_pages = 10
idle_seconds = 2
api_backoff_max_seconds = 30
hello_seconds = 60
drain_seconds = 120
settle_seconds = 10
allocation_seconds = 30
prediction_seconds = 90
source_seconds = 10

[delivery]
socket_path = "/delivery/provider.sock"
request_seconds = 30
retirement_seconds = 5
retry_initial_seconds = 1
retry_max_seconds = 30
