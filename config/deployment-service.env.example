# Private host settings for provider/deployment/install; replace paths/interface.
# CONFIG, SOURCE_ROOT and MAXIMUM_STARTUP_BYTES are generated from the bundle
# and deployment.toml, so they do not belong in this source profile.
NMRNET_RUNS_ROOT_INPUT=/srv/nmrnet/runs
NMRNET_MAXIMUM_NATIVE_REQUESTS_INPUT=8
NMRNET_HOST_DRAIN_SECONDS_INPUT=180
NMRNET_API_ROUTE_INPUT=external
NMRNET_STORE_ROUTE_INPUT=external
NMRNET_INTERPRETER_ROUTE_INPUT=external
NMRNET_EXTERNAL_INTERFACE_INPUT=YOUR_INTERFACE
NMRNET_RESOLVERS_INPUT="YOUR_IPV4_RESOLVER"
NMRNET_LOG_LEVEL_INPUT=INFO
