# Non-secret systemd EnvironmentFile: copy privately and replace these paths.
# The installer binds NMRNET_REPOSITORY_ROOT to the current checkout.
# Attempt state belongs to lifecycle.store_root in CONFIG, not this profile.
NMRNET_CONFIG_INPUT=/srv/nmrnet/input/provider.toml
NMRNET_SOURCE_ROOT_INPUT=/srv/nmrnet/input
NMRNET_RUNS_ROOT_INPUT=/srv/nmrnet/runs
NMRNET_MAXIMUM_STARTUP_BYTES_INPUT=2097152
NMRNET_MAXIMUM_NATIVE_REQUESTS_INPUT=8
NMRNET_HOST_DRAIN_SECONDS_INPUT=180
NMRNET_API_ROUTE_INPUT=mapped
NMRNET_STORE_ROUTE_INPUT=mapped
NMRNET_INTERPRETER_ROUTE_INPUT=external
NMRNET_MAPPED_INTERFACE_INPUT=lo
NMRNET_MAPPED_ADDRESSES_INPUT=nmr.localhost=127.0.0.1
NMRNET_EXTERNAL_INTERFACE_INPUT=eth0
NMRNET_RESOLVERS_INPUT="8.8.8.8 1.1.1.1"
NMRNET_LOG_LEVEL_INPUT=INFO
